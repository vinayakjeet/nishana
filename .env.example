# Copy to .env. Everything defaults to the mock provider, which needs no keys,
# so the full pipeline runs offline and CI stays green without secrets.
LLM_PROVIDER=mock

# Real providers (set LLM_PROVIDER accordingly). The frontier baseline and the
# blind judge need one of these; the synthetic seed generator needs another.
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
SARVAM_API_KEY=

# Baseline model override, e.g. llama-3.3-70b-versatile on groq.
FRONTIER_MODEL=
# Judge model override for blind pairwise quality.
JUDGE_MODEL=
